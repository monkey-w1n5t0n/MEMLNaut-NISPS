    mp.src37(gate) * amt_s37_d05_cross_mod_global +
    mp.src38(gate) * amt_s38_d05_cross_mod_global +
    mp.src39(gate) * amt_s39_d05_cross_mod_global +
    mp.src40(gate) * amt_s40_d05_cross_mod_global +
    mp.src41(gate) * amt_s41_d05_cross_mod_global +
    mp.src42(gate) * amt_s42_d05_cross_mod_global +
    mp.src43(gate) * amt_s43_d05_cross_mod_global +
    mp.src44(gate) * amt_s44_d05_cross_mod_global +
    mp.src45(gate) * amt_s45_d05_cross_mod_global +
    mp.src46(gate) * amt_s46_d05_cross_mod_global +
    mp.src47(gate) * amt_s47_d05_cross_mod_global;

mod_feedback_global(gate) =
    mp.src00(gate) * amt_s00_d06_feedback_global +
    mp.src01(gate) * amt_s01_d06_feedback_global +
    mp.src02(gate) * amt_s02_d06_feedback_global +
    mp.src03(gate) * amt_s03_d06_feedback_global +
    mp.src04(gate) * amt_s04_d06_feedback_global +
    mp.src05(gate) * amt_s05_d06_feedback_global +
    mp.src06(gate) * amt_s06_d06_feedback_global +
    mp.src07(gate) * amt_s07_d06_feedback_global +
    mp.src08(gate) * amt_s08_d06_feedback_global +
    mp.src09(gate) * amt_s09_d06_feedback_global +
    mp.src10(gate) * amt_s10_d06_feedback_global +
    mp.src11(gate) * amt_s11_d06_feedback_global +
    mp.src12(gate) * amt_s12_d06_feedback_global +
    mp.src13(gate) * amt_s13_d06_feedback_global +
    mp.src14(gate) * amt_s14_d06_feedback_global +
    mp.src15(gate) * amt_s15_d06_feedback_global +
    mp.src16(gate) * amt_s16_d06_feedback_global +
    mp.src17(gate) * amt_s17_d06_feedback_global +
    mp.src18(gate) * amt_s18_d06_feedback_global +
    mp.src19(gate) * amt_s19_d06_feedback_global +
    mp.src20(gate) * amt_s20_d06_feedback_global +
    mp.src21(gate) * amt_s21_d06_feedback_global +
    mp.src22(gate) * amt_s22_d06_feedback_global +
    mp.src23(gate) * amt_s23_d06_feedback_global +
    mp.src24(gate) * amt_s24_d06_feedback_global +
    mp.src25(gate) * amt_s25_d06_feedback_global +
    mp.src26(gate) * amt_s26_d06_feedback_global +
    mp.src27(gate) * amt_s27_d06_feedback_global +
    mp.src28(gate) * amt_s28_d06_feedback_global +
    mp.src29(gate) * amt_s29_d06_feedback_global +
    mp.src30(gate) * amt_s30_d06_feedback_global +
    mp.src31(gate) * amt_s31_d06_feedback_global +
    mp.src32(gate) * amt_s32_d06_feedback_global +
    mp.src33(gate) * amt_s33_d06_feedback_global +
    mp.src34(gate) * amt_s34_d06_feedback_global +
    mp.src35(gate) * amt_s35_d06_feedback_global +
    mp.src36(gate) * amt_s36_d06_feedback_global +
    mp.src37(gate) * amt_s37_d06_feedback_global +
    mp.src38(gate) * amt_s38_d06_feedback_global +
    mp.src39(gate) * amt_s39_d06_feedback_global +
    mp.src40(gate) * amt_s40_d06_feedback_global +
    mp.src41(gate) * amt_s41_d06_feedback_global +
    mp.src42(gate) * amt_s42_d06_feedback_global +
    mp.src43(gate) * amt_s43_d06_feedback_global +
    mp.src44(gate) * amt_s44_d06_feedback_global +
    mp.src45(gate) * amt_s45_d06_feedback_global +
    mp.src46(gate) * amt_s46_d06_feedback_global +
    mp.src47(gate) * amt_s47_d06_feedback_global;

mod_global_ratio(gate) =
    mp.src00(gate) * amt_s00_d07_global_ratio +
    mp.src01(gate) * amt_s01_d07_global_ratio +
    mp.src02(gate) * amt_s02_d07_global_ratio +
    mp.src03(gate) * amt_s03_d07_global_ratio +
    mp.src04(gate) * amt_s04_d07_global_ratio +
    mp.src05(gate) * amt_s05_d07_global_ratio +
    mp.src06(gate) * amt_s06_d07_global_ratio +
    mp.src07(gate) * amt_s07_d07_global_ratio +
    mp.src08(gate) * amt_s08_d07_global_ratio +
    mp.src09(gate) * amt_s09_d07_global_ratio +
    mp.src10(gate) * amt_s10_d07_global_ratio +
    mp.src11(gate) * amt_s11_d07_global_ratio +
    mp.src12(gate) * amt_s12_d07_global_ratio +
    mp.src13(gate) * amt_s13_d07_global_ratio +
    mp.src14(gate) * amt_s14_d07_global_ratio +
    mp.src15(gate) * amt_s15_d07_global_ratio +
    mp.src16(gate) * amt_s16_d07_global_ratio +
    mp.src17(gate) * amt_s17_d07_global_ratio +
    mp.src18(gate) * amt_s18_d07_global_ratio +
    mp.src19(gate) * amt_s19_d07_global_ratio +
    mp.src20(gate) * amt_s20_d07_global_ratio +
    mp.src21(gate) * amt_s21_d07_global_ratio +
    mp.src22(gate) * amt_s22_d07_global_ratio +
    mp.src23(gate) * amt_s23_d07_global_ratio +
    mp.src24(gate) * amt_s24_d07_global_ratio +
    mp.src25(gate) * amt_s25_d07_global_ratio +
    mp.src26(gate) * amt_s26_d07_global_ratio +
    mp.src27(gate) * amt_s27_d07_global_ratio +
    mp.src28(gate) * amt_s28_d07_global_ratio +
    mp.src29(gate) * amt_s29_d07_global_ratio +
    mp.src30(gate) * amt_s30_d07_global_ratio +
    mp.src31(gate) * amt_s31_d07_global_ratio +
    mp.src32(gate) * amt_s32_d07_global_ratio +
    mp.src33(gate) * amt_s33_d07_global_ratio +
    mp.src34(gate) * amt_s34_d07_global_ratio +
    mp.src35(gate) * amt_s35_d07_global_ratio +
    mp.src36(gate) * amt_s36_d07_global_ratio +
    mp.src37(gate) * amt_s37_d07_global_ratio +
    mp.src38(gate) * amt_s38_d07_global_ratio +
    mp.src39(gate) * amt_s39_d07_global_ratio +
    mp.src40(gate) * amt_s40_d07_global_ratio +
    mp.src41(gate) * amt_s41_d07_global_ratio +
    mp.src42(gate) * amt_s42_d07_global_ratio +
    mp.src43(gate) * amt_s43_d07_global_ratio +
    mp.src44(gate) * amt_s44_d07_global_ratio +
    mp.src45(gate) * amt_s45_d07_global_ratio +
    mp.src46(gate) * amt_s46_d07_global_ratio +
    mp.src47(gate) * amt_s47_d07_global_ratio;

mod_amp(gate) =
    mp.src00(gate) * amt_s00_d08_amp +
    mp.src01(gate) * amt_s01_d08_amp +
    mp.src02(gate) * amt_s02_d08_amp +
    mp.src03(gate) * amt_s03_d08_amp +
    mp.src04(gate) * amt_s04_d08_amp +
    mp.src05(gate) * amt_s05_d08_amp +
    mp.src06(gate) * amt_s06_d08_amp +
    mp.src07(gate) * amt_s07_d08_amp +
    mp.src08(gate) * amt_s08_d08_amp +
    mp.src09(gate) * amt_s09_d08_amp +
    mp.src10(gate) * amt_s10_d08_amp +
    mp.src11(gate) * amt_s11_d08_amp +
    mp.src12(gate) * amt_s12_d08_amp +
    mp.src13(gate) * amt_s13_d08_amp +
    mp.src14(gate) * amt_s14_d08_amp +
    mp.src15(gate) * amt_s15_d08_amp +
    mp.src16(gate) * amt_s16_d08_amp +
    mp.src17(gate) * amt_s17_d08_amp +
    mp.src18(gate) * amt_s18_d08_amp +
    mp.src19(gate) * amt_s19_d08_amp +
    mp.src20(gate) * amt_s20_d08_amp +
    mp.src21(gate) * amt_s21_d08_amp +
    mp.src22(gate) * amt_s22_d08_amp +
    mp.src23(gate) * amt_s23_d08_amp +
    mp.src24(gate) * amt_s24_d08_amp +
    mp.src25(gate) * amt_s25_d08_amp +
    mp.src26(gate) * amt_s26_d08_amp +
    mp.src27(gate) * amt_s27_d08_amp +
    mp.src28(gate) * amt_s28_d08_amp +
    mp.src29(gate) * amt_s29_d08_amp +
    mp.src30(gate) * amt_s30_d08_amp +
    mp.src31(gate) * amt_s31_d08_amp +
    mp.src32(gate) * amt_s32_d08_amp +
    mp.src33(gate) * amt_s33_d08_amp +
    mp.src34(gate) * amt_s34_d08_amp +
    mp.src35(gate) * amt_s35_d08_amp +
    mp.src36(gate) * amt_s36_d08_amp +
    mp.src37(gate) * amt_s37_d08_amp +
    mp.src38(gate) * amt_s38_d08_amp +
    mp.src39(gate) * amt_s39_d08_amp +
    mp.src40(gate) * amt_s40_d08_amp +
    mp.src41(gate) * amt_s41_d08_amp +
    mp.src42(gate) * amt_s42_d08_amp +
    mp.src43(gate) * amt_s43_d08_amp +
    mp.src44(gate) * amt_s44_d08_amp +
    mp.src45(gate) * amt_s45_d08_amp +
    mp.src46(gate) * amt_s46_d08_amp +
    mp.src47(gate) * amt_s47_d08_amp;

mod_pan(gate) =
    mp.src00(gate) * amt_s00_d09_pan +
    mp.src01(gate) * amt_s01_d09_pan +
    mp.src02(gate) * amt_s02_d09_pan +
    mp.src03(gate) * amt_s03_d09_pan +
    mp.src04(gate) * amt_s04_d09_pan +
    mp.src05(gate) * amt_s05_d09_pan +
    mp.src06(gate) * amt_s06_d09_pan +
    mp.src07(gate) * amt_s07_d09_pan +
    mp.src08(gate) * amt_s08_d09_pan +
    mp.src09(gate) * amt_s09_d09_pan +
    mp.src10(gate) * amt_s10_d09_pan +
    mp.src11(gate) * amt_s11_d09_pan +
    mp.src12(gate) * amt_s12_d09_pan +
    mp.src13(gate) * amt_s13_d09_pan +
    mp.src14(gate) * amt_s14_d09_pan +
    mp.src15(gate) * amt_s15_d09_pan +
    mp.src16(gate) * amt_s16_d09_pan +
    mp.src17(gate) * amt_s17_d09_pan +
    mp.src18(gate) * amt_s18_d09_pan +
    mp.src19(gate) * amt_s19_d09_pan +
    mp.src20(gate) * amt_s20_d09_pan +
    mp.src21(gate) * amt_s21_d09_pan +
    mp.src22(gate) * amt_s22_d09_pan +
    mp.src23(gate) * amt_s23_d09_pan +
    mp.src24(gate) * amt_s24_d09_pan +
    mp.src25(gate) * amt_s25_d09_pan +
    mp.src26(gate) * amt_s26_d09_pan +
    mp.src27(gate) * amt_s27_d09_pan +
    mp.src28(gate) * amt_s28_d09_pan +
    mp.src29(gate) * amt_s29_d09_pan +
    mp.src30(gate) * amt_s30_d09_pan +
    mp.src31(gate) * amt_s31_d09_pan +
    mp.src32(gate) * amt_s32_d09_pan +
    mp.src33(gate) * amt_s33_d09_pan +
    mp.src34(gate) * amt_s34_d09_pan +
    mp.src35(gate) * amt_s35_d09_pan +
    mp.src36(gate) * amt_s36_d09_pan +
    mp.src37(gate) * amt_s37_d09_pan +
    mp.src38(gate) * amt_s38_d09_pan +
    mp.src39(gate) * amt_s39_d09_pan +
    mp.src40(gate) * amt_s40_d09_pan +
    mp.src41(gate) * amt_s41_d09_pan +
    mp.src42(gate) * amt_s42_d09_pan +
    mp.src43(gate) * amt_s43_d09_pan +
    mp.src44(gate) * amt_s44_d09_pan +
    mp.src45(gate) * amt_s45_d09_pan +
    mp.src46(gate) * amt_s46_d09_pan +
    mp.src47(gate) * amt_s47_d09_pan;

// ---------------------------------------------------------------------------
// Derived signals
// ---------------------------------------------------------------------------

cent2ratio(c) = pow(2.0, c / 1200.0);
semi2ratio(s) = pow(2.0, s / 12.0);

// Base frequency: fine tune + pitch mod (semitones, ±12)
base_freq = freq * cent2ratio(fine_tune) * semi2ratio(mod_pitch(gate) * 12.0);

// Velocity gain — keeps _vel alive
vel_gain = (1.0 - 0.3) + 0.3 * vel;

// ---------------------------------------------------------------------------
// Effective per-operator ratios and levels (mod applied)
// global_ratio mod is an additive ratio offset (±8)
// ---------------------------------------------------------------------------
ratio_offset = mod_global_ratio(gate) * 8.0;
r1 = max(0.01, op1_ratio + ratio_offset);
r2 = max(0.01, op2_ratio + ratio_offset);
r3 = max(0.01, op3_ratio + ratio_offset);
r4 = max(0.01, op4_ratio + ratio_offset);

lev1 = max(0.0, min(1.0, op1_level + mod_op1_level(gate)));
lev2 = max(0.0, min(1.0, op2_level + mod_op2_level(gate)));
lev3 = max(0.0, min(1.0, op3_level + mod_op3_level(gate)));
lev4 = max(0.0, min(1.0, op4_level + mod_op4_level(gate)));

// ---------------------------------------------------------------------------
// Global multipliers for cross-mod and feedback.
// (1 + mod) in [0, 2] roughly; clamp to stay sane.
// ---------------------------------------------------------------------------
cross_mul = max(0.0, 1.0 + mod_cross_mod_global(gate));
fb_mul    = max(0.0, 1.0 + mod_feedback_global(gate));

m12e = m12 * cross_mul;  m13e = m13 * cross_mul;  m14e = m14 * cross_mul;
m21e = m21 * cross_mul;  m23e = m23 * cross_mul;  m24e = m24 * cross_mul;
m31e = m31 * cross_mul;  m32e = m32 * cross_mul;  m34e = m34 * cross_mul;
m41e = m41 * cross_mul;  m42e = m42 * cross_mul;  m43e = m43 * cross_mul;

fb1e = fb1 * fb_mul;
fb2e = fb2 * fb_mul;
fb3e = fb3 * fb_mul;
fb4e = fb4 * fb_mul;

// ---------------------------------------------------------------------------
// 4-operator FM bus — feedback loop via ~ on a 4-channel bus
// ---------------------------------------------------------------------------
fmbus(d1,d2,d3,d4) =
  op1_out, op2_out, op3_out, op4_out
with {
  f1 = base_freq * r1;
  f2 = base_freq * r2;
  f3 = base_freq * r3;
  f4 = base_freq * r4;

  op1_out = lev1 *
    os.osc(f1 + (m21e*d2 + m31e*d3 + m41e*d4 + fb1e*d1) * f1);

  op2_out = lev2 *
    os.osc(f2 + (m12e*d1 + m32e*d3 + m42e*d4 + fb2e*d2) * f2);

  op3_out = lev3 *
    os.osc(f3 + (m13e*d1 + m23e*d2 + m43e*d4 + fb3e*d3) * f3);

  op4_out = lev4 *
    os.osc(f4 + (m14e*d1 + m24e*d2 + m34e*d3 + fb4e*d4) * f4);
};

// Route 4-channel bus through feedback loop, sum all ops
fm_out = (fmbus ~ (si.bus(4))) : (_, _, _, _) :> _;

// ---------------------------------------------------------------------------
// Post-processing
// ---------------------------------------------------------------------------
soft_clip(x) = x / max(0.001, 1.0 + output_saturation * abs(x));
hp_out(x)    = fi.highpass(1, output_hp, x);

// Master amplitude destination (route an ADSR here for VCA)
amp_val = max(0.0, min(1.0, mod_amp(gate))) * master_level * vel_gain * 0.25;

// Pan
pan_val = max(-1.0, min(1.0, master_pan + mod_pan(gate)));
pan_l   = cos((pan_val + 1.0) * 0.25 * ma.PI);
pan_r   = sin((pan_val + 1.0) * 0.25 * ma.PI);

// Stereo spread via slight detuning (apply after main FM sum)
spread_cents = stereo_spread * 5.0;
spread_l     = cent2ratio(spread_cents);
spread_r     = cent2ratio(0.0 - spread_cents);

mono_post = fm_out * amp_val : soft_clip : hp_out;

signal_L = mono_post * spread_l * pan_l;
signal_R = mono_post * spread_r * pan_r;

process = signal_L, signal_R;
