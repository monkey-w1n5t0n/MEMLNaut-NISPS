// ---------------------------------------------------------------------------
master_level      = hslider("4_Master/00_master_level",      0.7,  0.0,  1.0,  0.001);
fine_tune         = hslider("4_Master/01_fine_tune[unit:ct]", 0.0, -50.0, 50.0, 0.1);
