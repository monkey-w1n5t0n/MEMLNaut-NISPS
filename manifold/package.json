{
  "name": "manifold",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Manifold — convertible-mode React front-end on the real NISPS ML+audio engine",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4273",
